# AI Task Manager — dependencias de ambiente
# Copie para .env (cp .env.example .env) e ajuste se necessario.

# --- Banco de dados ---------------------------------------------------------
POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=taskmanager

# --- Backend ----------------------------------------------------------------
SERVER_PORT=8080
DB_URL=jdbc:postgresql://postgres:5432/taskmanager
DB_USERNAME=taskmanager
DB_PASSWORD=taskmanager

# Origem liberada no CORS. Use virgula para varias origens.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- LLM (Ollama) -----------------------------------------------------------
# Dentro do compose o backend usa o host do servico ollama.
OLLAMA_BASE_URL=http://ollama:11434
# Para usar um Ollama rodando na maquina host em vez do container,
# troque a linha acima por: OLLAMA_BASE_URL=http://host.docker.internal:11434

# Candidatos com suporte a tool calling: qwen2.5:7b, llama3.1:8b
AI_MODEL=qwen2.5:7b
# 180s: modelo de 7b em CPU e a primeira chamada passam de um minuto (T-F06-08)
AI_TIMEOUT=180s
AI_MAX_RETRIES=1

# Assistente (F04): liga/desliga o registro das ferramentas no provedor; desligado,
# injeta um contexto pre-montado no prompt (fallback). Teto de resultados por leitura.
ASSISTANT_TOOL_CALLING=true
ASSISTANT_MAX_TOOL_RESULTS=10

# --- Frontend (dev) ----------------------------------------------------------
# Target do proxy /api do vite (frontend/vite.config.ts): para onde as chamadas
# de desenvolvimento vao. No container nginx do compose, o /api vai para o backend direto.
VITE_BACKEND_URL=http://localhost:8080
# Base URL consumida pelo cliente (frontend/src/api/client.ts). Padrao '/api',
# que em dev e o proxy do vite e no compose e o caminho do nginx.
VITE_API_BASE_URL=/api